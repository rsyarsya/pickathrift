# Hanya nilai publik. Jangan pernah menaruh rahasia di variabel NEXT_PUBLIC_*.

# Lokasi API backend, misalnya http://localhost:4000
NEXT_PUBLIC_API_URL=

# Setel ke "on" untuk membuka /dev/gallery, halaman yang menampilkan setiap state komponen.
# Biarkan kosong di semua lingkungan yang dideploy.
NEXT_PUBLIC_GALLERY=
